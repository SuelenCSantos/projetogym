# Config do app web do Firebase (Project settings > Your apps > SDK setup and configuration).
# Copie este arquivo para .env.local (que já está no .gitignore) e preencha com os valores reais.
# Essas chaves não são segredas - são feitas para ir no bundle do cliente. A segurança vem das
# regras do Firestore, não de esconder essas chaves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (fotos/vídeos do feed e foto de perfil) - cloudinary.com, plano
# gratuito, sem cartão. Cloud name fica no Dashboard; o upload preset é criado
# em Settings > Upload > Upload presets, com "Signing Mode" = Unsigned.
# Também não são segredos - servem exatamente pra upload direto do navegador.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
