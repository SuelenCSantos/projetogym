# Config do app web do Firebase (Project settings > Your apps > SDK setup and configuration).
# Copie este arquivo para .env.local (que já está no .gitignore) e preencha com os valores reais.
# Essas chaves não são segredas - são feitas para ir no bundle do cliente. A segurança vem das
# regras do Firestore/Storage, não de esconder essas chaves.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
