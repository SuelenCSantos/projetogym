rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Perfil básico (nome, foto, contadores, sequência) é sempre visível a
    // qualquer usuário logado, mesmo de conta privada - só os posts ficam
    // escondidos (ver regra de /posts abaixo). Mesmo padrão do Instagram.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // Reserva de nome de usuário único - criado junto com o users/{uid} numa
    // transação (ver claimUsername em src/lib/auth.ts).
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.followerUid == request.auth.uid;
      // só o alvo pode aceitar uma solicitação, e só pode mexer no campo status
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.targetUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      // unfollow (por quem segue) ou remover seguidor/recusar solicitação (pelo alvo)
      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.followerUid || request.auth.uid == resource.data.targetUid);
    }

    // Leitura liberada para qualquer usuário logado: quem vê o quê é decidido
    // pelas *consultas* que o app faz (feed só busca de quem você segue,
    // perfil privado só busca posts depois de confirmar que você é seguidor
    // aceito) - não pela regra em si. O arquivo de mídia em si (Cloudinary)
    // também é publicamente acessível por URL direta: sem servidor próprio,
    // essa é a troca consciente entre simplicidade e um bloqueio 100% à
    // prova de link direto.
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;
    }

    // Curtidas e comentários: a opção "permitir reações e comentários" do
    // autor é só respeitada pela UI (não mostra os botões), mesma filosofia
    // de simplicidade das regras acima.
    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.uid;
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.authorUid;
    }

    // Conversas: só os dois participantes podem ler/atualizar o documento.
    // "resource == null" cobre o get() de checagem feito antes de criar uma
    // conversa nova (documento ainda não existe nesse momento).
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
      allow delete: if false;
    }

    // Mensagens: id da conversa é `${uidA}_${uidB}` (uids ordenados) - não dá
    // pra adivinhar sem já saber os dois uids envolvidos. Mesma simplificação
    // de regras (sem get() cruzado) usada em posts/likes/comments acima.
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Notificações: quem criou (curtiu/comentou/mandou mensagem) é sempre
    // diferente do destinatário (checado em src/lib/notifications.ts antes
    // de criar). Só o destinatário lê/marca como lida/apaga as suas.
    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && request.auth.uid == resource.data.recipientUid;
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
    }
  }
}
